page {
  background: #120e24;
  color: #f1e9d2;
  font-family: -apple-system, "PingFang SC", "Microsoft YaHei", sans-serif;
}
.wrap { padding: 48rpx 32rpx; display: flex; flex-direction: column; align-items: center; gap: 24rpx; text-align: center; }
.title { font-size: 40rpx; font-weight: 700; color: #fff3c4; }
.hint { font-size: 28rpx; color: #b7aed4; line-height: 1.6; }
.amount { font-size: 64rpx; font-weight: 800; color: #f3b52f; }
.error { font-size: 28rpx; color: #ff8a80; }
.btn { width: 100%; min-height: 96rpx; line-height: 96rpx; border-radius: 24rpx; font-weight: 800; font-size: 32rpx; }
.btn-primary { background: #f3b52f; color: #2a1a00; }
.btn-plain { background: transparent; color: #f1e9d2; border: 2rpx solid #f7d77455; }
